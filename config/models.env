# Pinned versions and model files. Edit here, nothing else needs to change.
# Format: KEY=VALUE (read by scripts/*.sh and pipeline.py). Lines starting with # are comments.

# --- software (commits, so a fresh Mac gets exactly what was tested on Linux)
COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI.git
COMFYUI_REF=b65d1ffaca35fcda5889e120dcd0c8520553c7b2
GGUF_NODE_REPO=https://github.com/city96/ComfyUI-GGUF.git
GGUF_NODE_REF=6ea2651e7df66d7585f6ffee804b20e92fb38b8a
TRELLIS_MAC_REPO=https://github.com/shivampkumar/trellis-mac.git
TRELLIS_MAC_REF=main
PYTHON_VERSION=3.12

# --- engines (names used by `pipeline.py --engine`)
# klein9b: safe default on Mac (GGUF + bf16 text encoder, about 27 GB, no fp8 anywhere)
KLEIN_UNET_REPO=unsloth/FLUX.2-klein-9B-GGUF
KLEIN_UNET_FILE=flux-2-klein-9b-Q8_0.gguf
KLEIN_CLIP_REPO=Comfy-Org/vae-text-encorder-for-flux-klein-9b
KLEIN_CLIP_FILE=split_files/text_encoders/qwen_3_8b.safetensors
# dev: experimental on Mac until `pipeline.py bench` ran. The text encoder is the risk: fp8 weights can fail on MPS
# (no float8 dtype); the bf16 encoder is 35.6 GB. See docs/PIPELINES.md "dev on the Mac".
DEV_UNET_REPO=city96/FLUX.2-dev-gguf
DEV_UNET_FILE=flux2-dev-Q5_K_M.gguf
DEV_CLIP_REPO=Comfy-Org/flux2-dev
DEV_CLIP_FILE=split_files/text_encoders/mistral_3_small_flux2_bf16.safetensors
TURBO_LORA_REPO=Comfy-Org/flux2-dev
TURBO_LORA_FILE=split_files/loras/Flux2TurboComfyv2.safetensors
# shared VAE
VAE_REPO=Comfy-Org/vae-text-encorder-for-flux-klein-9b
VAE_FILE=split_files/vae/flux2-vae.safetensors

# --- defaults
DEFAULT_ENGINE=klein9b
DEFAULT_STYLE=character
COMFYUI_URL=http://127.0.0.1:8188
